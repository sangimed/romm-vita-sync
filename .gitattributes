# Normalize all text files to LF
* text=auto eol=lf

# Shell / build system files (critical for VitaSDK)
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Vita-specific binaries
*.vpk binary
*.elf binary
*.self binary
*.suprx binary
*.skprx binary
*.sfo binary

# Common binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.exe binary