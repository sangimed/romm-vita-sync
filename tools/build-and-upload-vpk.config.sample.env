# Copy this file to tools/build-and-upload-vpk.local.env and adjust values.
# FTP target settings for build-and-upload-vpk scripts.
# Missing or empty values fallback to script defaults.
# Build artifacts are always written to <repo>/build.
# FTP_HOST should match your Vita IP address shown in VitaShell FTP mode.

FTP_HOST=192.168.1.20
FTP_PORT=1337
FTP_REMOTE_DIR=ux0:/homebrews
